
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        AWS_DEFAULT_REGION = 'us-east-1'
        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'
    }

    stages {
        stage('Clone repo') {
            steps {
                sh '''
                    if git -C aws-infrastructure rev-parse --is-inside-work-tree >/dev/null 2>&1; then
                        echo "Repository exists. Updating..."
                        git -C aws-infrastructure pull --ff-only origin main
                    elif [ -e aws-infrastructure ]; then
                        echo "Error: aws-infrastructure exists but is not a Git repository"
                        exit 1
                    else
                        git clone --branch main \
                          https://github.com/sahilsarfaraz9492-deep/AWS-infra-ci-cd.git \
                          aws-infrastructure
                    fi

                    git -C aws-infrastructure status --short --branch
                '''
            }
        }

        stage('Format check') {
            steps {
                dir('aws-infrastructure') {
                    sh 'terraform fmt -check -recursive'
                }
            }
        }

        stage('Init') {
            steps {
                dir('aws-infrastructure') {
                    withCredentials([
                        string(credentialsId: 'aws-access-key-id',
                               variable: 'AWS_ACCESS_KEY_ID'),
                        string(credentialsId: 'aws-secret-access-key',
                               variable: 'AWS_SECRET_ACCESS_KEY')
                    ]) {
                        sh 'terraform init'
                    }
                }
            }
        }

        stage('Validate') {
            steps {
                dir('aws-infrastructure') {
                    sh 'terraform validate'
                }
            }
        }

        stage('Plan') {
            steps {
                dir('aws-infrastructure') {
                    withCredentials([
                        string(credentialsId: 'aws-access-key-id',
                               variable: 'AWS_ACCESS_KEY_ID'),
                        string(credentialsId: 'aws-secret-access-key',
                               variable: 'AWS_SECRET_ACCESS_KEY')
                    ]) {
                        sh 'terraform plan -out=tfplan'
                        sh 'terraform show -no-color tfplan > plan.txt'
                    }
                }
            }
        }

        stage('Apply') {
            input {
                message 'Approve applying the Terraform plan?'
                ok 'Apply'
            }
            steps {
                dir('aws-infrastructure') {
                    withCredentials([
                        string(credentialsId: 'aws-access-key-id',
                               variable: 'AWS_ACCESS_KEY_ID'),
                        string(credentialsId: 'aws-secret-access-key',
                               variable: 'AWS_SECRET_ACCESS_KEY')
                    ]) {
                        sh 'terraform apply tfplan'
                    }
                }
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'aws-infrastructure/plan.txt',
                             fingerprint: true
        }
        cleanup {
            cleanWs()
        }
    }
}
